# The sources of the audio-only FFmpeg the installers bundle (#215, D-798), pinned. The
# build script refuses a download whose SHA-256 differs; the release attaches exactly
# these archives as the program's complete source (with build.sh beside them).
FFMPEG_VERSION=9.0.2
FFMPEG_URL=https://ffmpeg.org/releases/ffmpeg-9.0.2.tar.xz
FFMPEG_SHA256=8c3850283eb25fa026482078a04051e0be17347b09ef81a0849bec15a96e002e
LAME_VERSION=3.100
LAME_URL=https://downloads.sourceforge.net/project/lame/lame/3.100/lame-3.100.tar.gz
LAME_SHA256=ddfe36cab873794038ae2c1210557ad34857a4b6bdc515785d1da9e175b1da1e
# espeak-ng, which espeakng-loader 0.2.4 builds from this tag and bundles (GPL-3.0-or-later):
# not built here, but its source goes into the same archive. GitHub's own tarball is not
# stable byte for byte, so the archive is `git archive` of the tag's commit, checked by hash.
ESPEAK_NG_VERSION=1.52.0
ESPEAK_NG_GIT=https://github.com/espeak-ng/espeak-ng.git
ESPEAK_NG_COMMIT=4870adfa25b1a32b4361592f1be8a40337c58d6c
ESPEAK_NG_SHA256=339ebe5ec0816ba48869e16578909bc8e91daeeed30b5ebd0acb14c3b06b5995
# The AppImage's type-2 runtime (packaging/tools.env), which every AppImage starts with: MIT
# itself, but statically linked with libfuse 3 (LGPL-2.1, with the runtime's own patch) and
# squashfuse (BSD-2-Clause), so their source goes into the archive too (#635 F3). The
# runtime's source at release 20251108, and the versions its scripts/common/
# install-dependencies.sh builds (libfuse's hash is the one that script checks).
APPIMAGE_RUNTIME_VERSION=20251108
APPIMAGE_RUNTIME_GIT=https://github.com/AppImage/type2-runtime.git
APPIMAGE_RUNTIME_COMMIT=dd6cebedcbddde9c82f89b011e8e1d40b6e43868
APPIMAGE_RUNTIME_SOURCE_SHA256=8024be0ad563fbdf8df31e65cc63870435d739c69ecc7adf0480bb21068f19d7
LIBFUSE_VERSION=3.15.0
LIBFUSE_URL=https://github.com/libfuse/libfuse/releases/download/fuse-3.15.0/fuse-3.15.0.tar.xz
LIBFUSE_SHA256=70589cfd5e1cff7ccd6ac91c86c01be340b227285c5e200baa284e401eea2ca0
SQUASHFUSE_VERSION=0.5.2
SQUASHFUSE_GIT=https://github.com/vasi/squashfuse.git
SQUASHFUSE_COMMIT=775b4cc72ab47641637897f11ce0da15d5c1f115
SQUASHFUSE_SHA256=9e5cc32e458af8a37bb8ab1c01c1a8c34354a36ded1f4c10a45b437cab94f31e
