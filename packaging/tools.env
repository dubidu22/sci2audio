# The programs that make the installers (#215, D-797), pinned by SHA-256; the workflow
# refuses a download that differs. None of them runs on a tester's computer except the
# AppImage runtime and the Inno Setup installer stub, which become part of the installers.
# Inno Setup (Windows installer); the hash is the one in the publisher's signed .issig file.
INNO_SETUP_VERSION=6.7.4
INNO_SETUP_URL=https://github.com/jrsoftware/issrc/releases/download/is-6_7_4/innosetup-6.7.4.exe
INNO_SETUP_SHA256=a549929319f9120716677c685535ca4671e4b937b5fdc87e2585f32d8eb30e8c
# appimagetool (Linux) and the static type-2 runtime it puts in front of the AppImage; with
# --runtime-file appimagetool downloads nothing.
APPIMAGETOOL_URL=https://github.com/AppImage/appimagetool/releases/download/1.9.0/appimagetool-x86_64.AppImage
APPIMAGETOOL_SHA256=46fdd785094c7f6e545b61afcfb0f3d98d8eab243f644b4b17698c01d06083d1
APPIMAGE_RUNTIME_URL=https://github.com/AppImage/type2-runtime/releases/download/20251108/runtime-x86_64
APPIMAGE_RUNTIME_SHA256=2fca8b443c92510f1483a883f60061ad09b46b978b2631c807cd873a47ec260d
