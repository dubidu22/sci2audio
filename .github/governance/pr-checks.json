{
  "ownership_labels": [
    "lane:core",
    "lane:extraction",
    "lane:layout",
    "lane:textprep",
    "lane:voices",
    "lane:output",
    "lane:app",
    "lane:web",
    "lane:cli",
    "lane:infra",
    "lane:docs"
  ],
  "label_paths": {
    "lane:core": [
      "src/sci2audio/core/**"
    ],
    "lane:extraction": [
      "src/sci2audio/extraction/**"
    ],
    "lane:layout": [
      "src/sci2audio/layout/**"
    ],
    "lane:textprep": [
      "src/sci2audio/textprep/**",
      "src/sci2audio/testing/**"
    ],
    "lane:voices": [
      "src/sci2audio/voices/**"
    ],
    "lane:output": [
      "src/sci2audio/output/**"
    ],
    "lane:app": [
      "src/sci2audio/app/**"
    ],
    "lane:web": [
      "src/sci2audio/web/**"
    ],
    "lane:cli": [
      "src/sci2audio/cli.py"
    ],
    "lane:infra": [
      ".github/**",
      "pyproject.toml",
      "uv.lock",
      ".pre-commit-config.yaml",
      "governance/claude-project-rules.yaml",
      "governance/rules/**",
      "governance/project_instructions.md",
      "governance/governance-config.json",
      "governance/github-setup/**",
      "governance/tools/**"
    ],
    "lane:docs": [
      "*.md",
      "docs/**",
      "docs/design/**",
      ".claude/**",
      "governance/kb/**",
      "governance/plans/**",
      "governance/ledger/**",
      "governance/project-state.yaml",
      "governance/memory/**",
      "governance/release/**",
      "governance/workflow-export.md"
    ]
  },
  "open_labels": [
    "lane:docs"
  ],
  "lock_label": "lane:infra",
  "locked_label": "lane:core",
  "critical_paths": [
    "src/sci2audio/core/**",
    ".github/**",
    "pyproject.toml",
    "uv.lock",
    "tests/corpus/**",
    "tests/unit/__snapshots__/**",
    "tests/regression/**",
    "THIRD_PARTY_LICENSES.md",
    "governance/claude-project-rules.yaml",
    "governance/rules/**",
    "governance/project_instructions.md",
    "governance/governance-config.json"
  ],
  "doc_paths": [
    "docs/**",
    "**/README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    ".github/**",
    ".claude/**"
  ],
  "governance_paths": [
    "governance/kb/**",
    "governance/plans/**",
    "governance/ledger/**",
    "governance/project-state.yaml",
    "governance/memory/**",
    "governance/release/**",
    "governance/workflow-export.md"
  ]
}
