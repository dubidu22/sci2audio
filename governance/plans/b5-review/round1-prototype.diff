+_TWO_GLYPH_ARROW = re.compile("←\u2212+→|←\u2212+|\u2212+→")
+
+
+def _one_arrow(glyphs: str) -> str:
+    return "↔" if glyphs.endswith("→") and glyphs.startswith("←") else glyphs[0] if glyphs[0] == "←" else "→"
+
+
+def as_one_arrow(text: str, found: list[Candidate]) -> str:
+    """The text with each two-glyph arrow written as its one arrow, padded to the same length."""
+    for c in found:
+        text = text[: c.start] + c.replacement * (c.end - c.start) + text[c.end :]
+    return text
 
 
