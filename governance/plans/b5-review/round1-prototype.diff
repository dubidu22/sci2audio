-        one = _ONE_ARROW[match[0]]
+        one = _one_arrow(match[0])
         reason = f'arrow printed as two glyphs "{match[0]}" read as one arrow "{one}"'
         found.append(Candidate(*match.span(), one, reason))
     return found
