+def _run_tags(block: Block, items) -> list[tuple[int, int, tuple[str, ...]]]:
+    """The block's tagged runs as (start, end, tags) in its text (a hidden run, #463)."""
+    out = []
+    for part in block.parts:
+        line = items[part.item][1]
+        if not isinstance(line, TextLine) or block.text[part.start : part.start + len(line.text)] != line.text:
+            continue
+        offset = part.start
+        for run in line.runs:
+            if run.tags and run.text:
+                out.append((offset, offset + len(run.text), tuple(run.tags)))
+            offset += len(run.text)
+    return out
+
