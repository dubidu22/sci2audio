+def raised_numbers(document: Document) -> dict[int, list[tuple[int, int]]]:
+    """Where each block holds a run of digits set small and raised (tagged `sup`, or the size
+    and rise of `_raised_marks`), by block: a mass number such as the "40" of "⁴⁰K" (#449)."""
+    items = document.content.items()
+    found: dict[int, list[tuple[int, int]]] = {}
+    for index, block in enumerate(document.blocks):
+        lines = list(_lines(items, block))
+        main = _main_size(run for _, _, line in lines for run in line.runs)
+        for _, offset, line in lines:
+            for run in line.runs:
+                if _MASS_NUMBER.fullmatch(run.text) and _set_small(run, main):
+                    if _superscript(run, line, main):
