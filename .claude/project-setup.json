{
  "name": "sci2audio",
  "size": "open-source",
  "autonomy": "autonomous",
  "economy": "balanced",
  "checks": "uv run ruff check && uv run ruff format --check && uv run lint-imports && uv run deptry src && uv run pytest -m \"not slow and not benchmark and not browser\"",
  "critical_paths": [
    ".github/**",
    ".claude/**",
    "CLAUDE.md",
    "src/sci2audio/core/**",
    "pyproject.toml",
    "uv.lock",
    "tests/corpus/**",
    "tests/unit/__snapshots__/**",
    "tests/regression/**",
    "THIRD_PARTY_LICENSES.md"
  ],
  "lanes": {
    "core": ["src/sci2audio/core/**"],
    "extraction": ["src/sci2audio/extraction/**"],
    "layout": ["src/sci2audio/layout/**"],
    "textprep": ["src/sci2audio/textprep/**", "src/sci2audio/testing/**"],
    "voices": ["src/sci2audio/voices/**"],
    "output": ["src/sci2audio/output/**"],
    "app": ["src/sci2audio/app/**"],
    "web": ["src/sci2audio/web/**"],
    "cli": ["src/sci2audio/cli.py"],
    "infra": [".github/**", "pyproject.toml", "uv.lock", ".pre-commit-config.yaml"],
    "docs": ["*.md", "docs/**", ".claude/**", "governance/kb/**"]
  },
  "licence_gate": false,
  "label_workflow": false
}
