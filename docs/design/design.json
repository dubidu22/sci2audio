  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Ink-filled action; one per region. Cobalt is never a button fill.",
      "html": "<button class=\"ds-btn-primary\">Continue from 28:14</button>",
      "css": ".ds-btn-primary{font-family:var(--ui,'Atkinson Hyperlegible',system-ui,sans-serif);display:inline-flex;align-items:center;gap:8px;min-height:38px;padding:7px 14px;border-radius:4px;border:1px solid var(--rule-strong,#8C9199);font-weight:700;font-size:14.5px;cursor:pointer;background:var(--ink,#16181D);border-color:var(--ink,#16181D);color:var(--paper,#FFFFFF);transition:background .2s cubic-bezier(.16,1,.3,1)}.ds-btn-primary:hover{background:var(--ink-2,#3A3E46)}.ds-btn-primary:focus-visible{outline:2px solid var(--cobalt,#2340A8);outline-offset:2px;}"
    },
    {
      "name": "Button",
      "kind": "button",
      "refersTo": "button",
      "description": "Default outlined paper button.",
      "html": "<button class=\"ds-btn\">Start of the chapter</button>",
      "css": ".ds-btn{font-family:var(--ui,'Atkinson Hyperlegible',system-ui,sans-serif);display:inline-flex;align-items:center;gap:8px;min-height:38px;padding:7px 14px;border-radius:4px;border:1px solid var(--rule-strong,#8C9199);font-weight:700;font-size:14.5px;cursor:pointer;background:var(--paper,#FFFFFF);color:var(--ink,#16181D)}.ds-btn:hover{background:var(--desk-2,#E3E6EA)}.ds-btn:focus-visible{outline:2px solid var(--cobalt,#2340A8);outline-offset:2px;}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Label above, hint below in pencil; hairline-outlined paper field.",
      "html": "<div class=\"ds-field\"><label for=\"ds-f\">Output folder</label><input id=\"ds-f\" class=\"ds-input\" value=\"~/Audiobooks\"><span>Your audiobook stays in this folder.</span></div>",
      "css": ".ds-field{font-family:var(--ui,'Atkinson Hyperlegible',system-ui,sans-serif);display:grid;gap:6px;max-width:360px;color:var(--ink,#16181D)}.ds-field label{font-weight:700;font-size:14px}.ds-field span{color:var(--pencil,#5A5E66);font-size:13.5px}.ds-input{font:inherit;font-size:15px;min-height:38px;padding:7px 10px;border:1px solid var(--rule-strong,#8C9199);border-radius:4px;background:var(--paper,#FFFFFF);color:var(--ink,#16181D)}.ds-input:focus-visible{outline:2px solid var(--cobalt,#2340A8);outline-offset:2px;}"
    },
    {
      "name": "Rail Navigation",
      "kind": "nav",
      "refersTo": "nav-item",
      "description": "Cobalt binder rail; the current item becomes a paper tab.",
      "html": "<nav class=\"ds-rail\"><a href=\"#\" aria-current=\"page\">Library<span>7</span></a><a href=\"#\">Captures<span>9</span></a><a href=\"#\">Voices</a></nav>",
      "css": ".ds-rail{font-family:var(--ui,'Atkinson Hyperlegible',system-ui,sans-serif);background:var(--cobalt,#2340A8);padding:12px;display:grid;gap:2px;width:240px}.ds-rail a{display:flex;align-items:center;gap:12px;padding:9px 10px;border-radius:4px;color:#FFFFFF;text-decoration:none;font-size:15px}.ds-rail a span{margin-left:auto;font-size:13px;color:var(--on-cobalt-2,#CCD5F4);font-variant-numeric:tabular-nums}.ds-rail a:hover{background:var(--cobalt-deep,#1A3087)}.ds-rail a[aria-current=page]{background:var(--paper,#FFFFFF);color:var(--ink,#16181D);font-weight:700}.ds-rail a[aria-current=page] span{color:var(--pencil,#5A5E66)}.ds-rail a:focus-visible{outline:2px solid var(--hl-read,#FFE94A);outline-offset:2px}"
    },
    {
      "name": "State Chips",
      "kind": "chip",
      "refersTo": "chip-ready",
      "description": "Icon plus word; outlines and washes, never fluorescent, never button-like.",
      "html": "<div class=\"ds-chips\"><span class=\"ds-state ds-ready\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"m4.5 12.5 5 5 10-11\"/></svg>Ready</span><span class=\"ds-state ds-making\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" aria-hidden=\"true\"><path d=\"M3 12h2M7 8v8M11 5v14M15 9v6M19 7v10\"/></svg>Making</span><span class=\"ds-state ds-warn\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 3 2.5 20h19z\"/><path d=\"M12 10v4.5M12 17.5h.01\"/></svg>Offline</span><span class=\"ds-state ds-failed\"><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M12 3 2.5 20h19z\"/><path d=\"M12 10v4.5M12 17.5h.01\"/></svg>Stopped</span></div>",
      "css": ".ds-chips{display:flex;gap:10px;flex-wrap:wrap}.ds-state{font-family:var(--ui,'Atkinson Hyperlegible',system-ui,sans-serif);display:inline-flex;align-items:center;gap:6px;font-size:13.5px;font-weight:700;padding:2px 8px 2px 6px;border-radius:4px;white-space:nowrap}.ds-ready{color:var(--ink,#16181D);box-shadow:inset 0 0 0 1px var(--rule-strong,#8C9199)}.ds-making{color:var(--ink,#16181D);box-shadow:inset 0 0 0 1px var(--ink,#16181D);border-radius:999px}.ds-warn{color:var(--wait,#7A4B00);box-shadow:inset 0 0 0 1px currentColor;border-radius:999px}.ds-failed{background:var(--error-wash,#FDECEA);color:var(--error,#B42318)}"
    },
    {
      "name": "Capture Flags",
      "kind": "custom",
      "refersTo": "flag",
      "description": "Squared highlighter tabs, one colour per capture type.",
      "html": "<div class=\"ds-flags\"><span class=\"ds-flag\" style=\"--c:#7BE38A\"><svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 20h4L19 9l-4-4L4 16z\"/><path d=\"m13 7 4 4\"/></svg></span><span class=\"ds-flag\" style=\"--c:#6CC4FF\"><svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 17c3 0 4-2 4-5V7H5v5h4M15 17c3 0 4-2 4-5V7h-4v5h4\"/></svg></span><span class=\"ds-flag\" style=\"--c:#FF8FC8\"></span><span class=\"ds-flag\" style=\"--c:#FFB347\"></span></div>",
      "css": ".ds-flags{display:grid;gap:6px;justify-items:start}.ds-flag{display:inline-grid;place-items:center;width:24px;height:18px;background:var(--c);color:#16181D;border-radius:0 3px 3px 0;box-shadow:inset 0 0 0 1px rgba(22,24,29,.28);transition:transform .45s cubic-bezier(.16,1,.3,1)}.ds-flag:hover{transform:translateX(3px)}"
    },
    {
      "name": "Capture (marginalia)",
      "kind": "custom",
      "refersTo": "flag",
      "description": "A ruled row with a hanging flag; cancelled state strikes through in pencil with restore.",
      "html": "<div class=\"ds-caps\"><article class=\"ds-cap\"><span class=\"ds-flag2\" style=\"--c:#6CC4FF\"><svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 17c3 0 4-2 4-5V7H5v5h4M15 17c3 0 4-2 4-5V7h-4v5h4\"/></svg></span><span class=\"k\">Quote to cite</span><q>Reaction times on the vigilance task fell by 12 ms for each additional hour of sleep.</q><span class=\"f\">p. 7 · 18:42</span></article><article class=\"ds-cap ds-cancelled\"><span class=\"ds-flag2\" style=\"--c:#7BE38A\"><svg width=\"12\" height=\"12\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M4 20h4L19 9l-4-4L4 16z\"/><path d=\"m13 7 4 4\"/></svg></span><span class=\"k\">Note</span><q>Naps were not counted.</q><span class=\"f\">p. 7 · 19:05<button><svg width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.75\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M9 14 4 9l5-5\"/><path d=\"M4 9h10a6 6 0 0 1 0 12h-3\"/></svg>Restore</button></span></article></div>",
      "css": ".ds-caps{font-family:var(--ui,'Atkinson Hyperlegible',system-ui,sans-serif);max-width:320px;border-bottom:1px solid var(--rule,#D7DADF);color:var(--ink,#16181D)}.ds-cap{border-top:1px solid var(--rule,#D7DADF);padding:14px 4px 14px 40px;position:relative;display:grid;gap:6px}.ds-flag2{position:absolute;left:0;top:14px;display:inline-grid;place-items:center;width:24px;height:18px;background:var(--c);color:#16181D;border-radius:0 3px 3px 0;box-shadow:inset 0 0 0 1px rgba(22,24,29,.28)}.ds-cap .k{font-size:12.5px;font-weight:700;color:var(--pencil,#5A5E66)}.ds-cap q{font:italic 400 15.5px/1.5 var(--read,Literata,Georgia,serif);quotes:none}.ds-cap .f{display:flex;align-items:center;gap:8px;font-size:13px;color:var(--pencil,#5A5E66);font-variant-numeric:tabular-nums}.ds-cap .f button{margin-left:auto;display:inline-flex;gap:6px;align-items:center;border:0;background:none;font:inherit;font-weight:700;color:var(--ink,#16181D);padding:4px 8px;border-radius:4px;cursor:pointer}.ds-cap .f button:hover{background:var(--desk-2,#E3E6EA)}.ds-cancelled{border-top-style:dashed}.ds-cancelled q{text-decoration:line-through;color:var(--pencil,#5A5E66)}"
    },
    {
      "name": "Reading Sweep",
      "kind": "custom",
      "refersTo": "sheet",
      "description": "Literata on paper; the sentence being read fills with reading yellow, skipped citations struck in pencil.",
      "html": "<div class=\"ds-sheet\"><p>Reaction times fell by 12 ms per hour of sleep <span class=\"cut\">(t(34) = 2.81, p &lt; .01)</span>. <span class=\"ds-s\">Naps, e.g. after lunch, were not counted.</span></p></div>",
      "css": ".ds-sheet{background:var(--paper,#FFFFFF);box-shadow:0 1px 2px rgba(22,24,29,.06),0 8px 24px -12px rgba(22,24,29,.18);border-radius:2px;padding:28px 40px;max-width:520px}.ds-sheet p{font:400 20px/1.8 Literata,Georgia,serif;color:var(--ink,#16181D);margin:0}.ds-sheet .cut{color:var(--pencil,#5A5E66);text-decoration:line-through;font-size:.92em}.ds-s{background-image:linear-gradient(#FFE94A,#FFE94A);background-color:rgba(255,233,74,.3);background-repeat:no-repeat;background-size:60% 100%;transition:background-size 2s linear;border-radius:2px;padding:2px 0;-webkit-box-decoration-break:clone;box-decoration-break:clone}.ds-sheet:hover .ds-s{background-size:100% 100%}"
    },
    {
      "name": "Toast with Undo",
      "kind": "custom",
      "refersTo": "toast",
      "description": "Ink popover confirming a capture, with undo.",
      "html": "<div class=\"ds-toast\"><span class=\"ds-tf\"></span><span>Note saved at p. 7</span><button>Undo</button></div>",
      "css": ".ds-toast{font-family:var(--ui,'Atkinson Hyperlegible',system-ui,sans-serif);display:flex;gap:12px;align-items:center;background:var(--ink,#16181D);color:var(--paper,#FFFFFF);border-radius:4px;padding:10px 12px 10px 14px;box-shadow:0 2px 6px rgba(22,24,29,.10),0 16px 40px -16px rgba(22,24,29,.30);font-size:14.5px;min-width:320px}.ds-tf{width:24px;height:18px;background:#7BE38A;border-radius:0 3px 3px 0}.ds-toast button{margin-left:auto;background:none;border:1px solid rgba(255,255,255,.5);color:inherit;border-radius:4px;padding:4px 10px;font:inherit;font-weight:700;font-size:13.5px;cursor:pointer}.ds-toast button:hover{background:rgba(255,255,255,.12)}.ds-toast button:focus-visible{outline:2px solid #6CC4FF;outline-offset:2px}"
